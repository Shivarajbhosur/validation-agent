# ============================================
# VALIDATION AGENT - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values

# --- PATHS ---
# Workspace where baselines are copied TO (destination for `compare` runs).
WORKSPACE_PATH=C:/Clients/SSAB.OX/baseline
# Source where baselines are copied FROM (usually the shared G drive).
SOURCE_PATH=G:/Clients/SSAB-OX/Validation
# Local clone of the PowerShellScriptLibrary repo.
PS_LIBRARY_PATH=C:/Users/YOUR_USERNAME/git/PowerShellScriptLibrary
SESSIONS_PATH=./data/sessions
REPORTS_PATH=./data/reports
LOGS_PATH=./data/logs

# --- COMPARE SCRIPT ---
# Full path to CompareX.ps1 on your machine.
COMPARE_SCRIPT_PATH=C:/Clients/SSAB.OX/baseline/CompareX.ps1
# Command template used by the compare skill. Leave default unless you know
# what you're doing — {baseline_name} is substituted at runtime.
COMPARE_COMMAND=compare-x -BaselineName "{baseline_name}" -PromptOnFail $false -GenerateReportOn All

# --- SSAB.OX CODEBASE (local checkout) ---
# Path to your local clone of the SSAB.OX C# repository. Live-file reads,
# program-file lookups, and `dotnet run` all use this path. Leave the
# derived SSAB_OX_PROJECT_PATH blank to auto-derive it as
# <SSAB_OX_REPO_PATH>/src/SSAB.OX/SSAB.OX.
SSAB_OX_REPO_PATH=C:/Users/YOUR_USERNAME/git/SSAB.OX
SSAB_OX_PROJECT_PATH=

# --- LOCAL GIT REPO (used by branch / finalize skills) ---
# Usually the same as SSAB_OX_REPO_PATH.
GIT_REPO_PATH=C:/Users/YOUR_USERNAME/git/SSAB.OX
GIT_MAIN_BRANCH=develop

# --- COBOL SOURCE (local checkout, optional) ---
# Path to your local COBOL source root. Leave empty to disable live COBOL
# reads (the app will fall back to KB snapshots).
COBOL_SOURCE_PATH=

# --- EXPERLIB RUNTIME (optional) ---
# Path to the ExperLib runtime library repo. Leave empty to disable the
# analysis-agent's ExperLib type-injection feature.
EXPERLIB_REPO_PATH=

# --- AZURE DEVOPS ---
AZURE_DEVOPS_ORG=https://dev.azure.com/YOUR_ORG
AZURE_DEVOPS_PROJECT=YOUR_PROJECT
AZURE_DEVOPS_REPO=YOUR_REPO
AZURE_DEVOPS_PAT=YOUR_PAT_TOKEN

# --- WIKI HELP (optional, chat_agent guides users via ADO wiki) ---
# Leave WIKI_ID empty to auto-detect the project's default wiki.
# Set WIKI_ID=DISABLED to turn the feature off (chat runs exactly as before).
# PAT above must have "Wiki (Read)" scope.
AZURE_DEVOPS_WIKI_ID=
WIKI_CACHE_TTL_SECONDS=1800
WIKI_ASSISTANT_NAME=

# --- ENSO AI (For Step 4 - Week 6+) ---
ENSO_AI_API_URL=
ENSO_AI_API_KEY=

# --- REPORT DELIVERY ---
REPORT_DELIVERY_PATH=//server/reports

# --- LOGGING ---
LOG_LEVEL=INFO