# --- PATHS ---
WORKSPACE_PATH=C:/Clients/SSAB.OX/baseline
SOURCE_PATH=G:/Clients/SSAB-OX/Validation
PS_LIBRARY_PATH=C:/Users/shosur/git/PowerShellScriptLibrary
COMPARE_SCRIPT_PATH=C:\Clients\SSAB.OX\baseline\CompareX.ps1
SESSIONS_PATH=./data/sessions
LOGS_PATH=./data/logs

# COBOL Source Path
COBOL_SOURCE_PATH=G:\Clients\SSAB-OX\SCAN\COB

# CompareX Command (PowerShell module)(SSAB-OX)
COMPARE_COMMAND=compare-x -BaselineName "{baseline_name}" -PromptOnFail $false -GenerateReportOn All

# Azure DevOps Configuration
AZURE_DEVOPS_ORG=ExperSolve
AZURE_DEVOPS_PROJECT=SSAB-OX
AZURE_DEVOPS_REPO=SSAB.OX
#AZURE_DEVOPS_PAT=55wwOUqzipixyeWgWQ1g0SPCZsZde00Fps7owirxfOtuYMTgHE9EJQQJ99CDACAAAAAFoSx1AAASAZDOWWPp below
#AZURE_DEVOPS_PAT=45BlwSug2I9xFDc2CBnFbHcXfpEhXJ5ce06N4tpUdvfxBYovVlSAJQQJ99CGACAAAAAFoSx1AAASAZDOiZ1u

# --- WIKI HELP (optional, chat_agent guides users via ADO wiki) ---
# Leave WIKI_ID empty to auto-detect the project's default wiki.
# Set WIKI_ID=DISABLED to turn the feature off (chat runs exactly as before).
# PAT above must have "Wiki (Read)" scope.
AZURE_DEVOPS_WIKI_ID=
WIKI_CACHE_TTL_SECONDS=1800
WIKI_ASSISTANT_NAME=SSAB-OX Wiki Assistant


# --- SSAB.OX CODEBASE (local checkout) ---
# Path to your local clone of the SSAB.OX C# repository. Live-file reads,
# program-file lookups, and `dotnet run` all use this path.
SSAB_OX_REPO_PATH=C:/Users/shosur/git/SSAB.OX
# Leave SSAB_OX_PROJECT_PATH commented out to auto-derive as
# <SSAB_OX_REPO_PATH>/src/SSAB.OX/SSAB.OX. Uncomment to override.
#SSAB_OX_PROJECT_PATH=



# Local Git Repo Path
GIT_REPO_PATH=C:\Users\shosur\git\SSAB.OX
#GIT_MAIN_BRANCH=master
GIT_MAIN_BRANCH=develop

# ExperLib runtime library repo path (optional; leave empty to disable).
# When set, AnalysisAgent auto-injects ExperLib type sources into fix prompts
# so the AI sees the real API (DateType, SqlQuery, Clock, etc.) instead of
# guessing. On-demand file reads — no ingestion required.
EXPERLIB_REPO_PATH=C:\Users\shosur\git\ExperLib

# --- ENSO AI (unified gateway) ---
# Single endpoint + single key for every LLM provider (OpenAI / Anthropic /
# Gemini / Bedrock). Only the model id below changes between calls.
API_URL=https://api.ensoai.ensono.com/v1/chat/completions
API_KEY=UoqqKO3XUKCBjef1rxoakJUXo4ow

# Default model (must match an `id:` in prompts/model_registry.yaml).
# Override per-request from code/UI via call_llm(..., model_override=...).
DEFAULT_MODEL=@openai-foundry-devgateway/gpt-4.1

#@aws-anthropic-devgateway/us.anthropic.claude-sonnet-4-6 
